# Copier ce fichier vers .env et remplir. NE JAMAIS commiter .env.

# Bot Telegram (créé via @BotFather) et chat_id de destination
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# Compte MT5. Si le terminal est déjà ouvert et connecté, ces 3 variables
# peuvent rester vides (initialize() s'attache au terminal en cours).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Chemin du terminal MT5 si plusieurs installations (sinon laisser vide)
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PATH=
